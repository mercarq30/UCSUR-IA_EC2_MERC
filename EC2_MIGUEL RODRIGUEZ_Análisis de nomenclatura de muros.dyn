    {
      "ConcreteType": "DSRevitNodesUI.ElementsOfCategory, DSRevitNodesUI",
      "Id": "c7ed17250c234fe1a40e3612c676bd89",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "d6cf6d6da89c40648883a2c3f01b16a1",
          "Name": "Category",
